<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/now_playing_seekBarLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/material_standard_horizontal_spacing"
    android:paddingTop="@dimen/material_content_spacing"
    android:paddingEnd="@dimen/material_standard_horizontal_spacing">

    <SeekBar
        android:id="@+id/now_playing_seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="3dp"
        android:minHeight="3dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:progressBackgroundTint="?attr/app_color_on_surface"
        android:progressTint="?attr/app_color_on_surface"
        android:thumbTint="?attr/app_color_on_surface" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/now_playing_elapsedTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/app_color_on_surface" />

        <TextView
            android:id="@+id/now_playing_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/app_color_on_surface" />
    </RelativeLayout>
</LinearLayout>
